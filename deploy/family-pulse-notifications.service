[Unit]
Description=Family Pulse notification runner
After=network.target postgresql.service

[Service]
Type=oneshot
User=sovereign
WorkingDirectory=/opt/sovereign-home/apps/familyPulse
EnvironmentFile=/opt/sovereign-home/apps/familyPulse/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/sovereign-home/apps/familyPulse/scripts/send-notifications.js
