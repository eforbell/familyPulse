[Unit]
Description=Forbell Family Pulse notification runner
After=network.target postgresql.service

[Service]
Type=oneshot
User=forbell
WorkingDirectory=/data/apps/familyPulse
EnvironmentFile=/data/apps/familyPulse/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /data/apps/familyPulse/scripts/send-notifications.js
