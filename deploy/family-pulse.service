[Unit]
Description=Family Pulse App
After=network.target postgresql.service

[Service]
Type=simple
User=sovereign
WorkingDirectory=/opt/sovereign-home/apps/familyPulse
EnvironmentFile=/opt/sovereign-home/apps/familyPulse/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/sovereign-home/apps/familyPulse/server.js
Restart=always
RestartSec=5
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
