[Unit]
Description=Forbell Family Pulse App
After=network.target postgresql.service

[Service]
Type=simple
User=forbell
WorkingDirectory=/data/apps/familyPulse
EnvironmentFile=/data/apps/familyPulse/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /data/apps/familyPulse/server.js
Restart=always
RestartSec=5
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
