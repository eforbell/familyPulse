# ── Required ──────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@localhost:5434/familypulse

PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# ── Optional ─────────────────────────────────────────────────
PORT=3003
# Listen address; loopback by default so the app is reached only through your proxy. Set 0.0.0.0 to
# expose it directly (e.g. in a container). Home Base sets SOVEREIGN_LISTEN=unix:/run/sovereign-apps/family-pulse/app.sock
# instead, a socket only nginx can reach.
# HOST=127.0.0.1
HOUSEHOLD_TIMEZONE=America/New_York
FP_TRANSACTION_FILES_DIR=/data/apps/familyPulse/transaction-files

# OpenAI (for AI features: digest, what-if, on-demand analysis)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_QUERY_MODEL=
OPENAI_ANOMALY_DIGEST_MODEL=

# Plaid OAuth redirect (production only)
PLAID_OAUTH_REDIRECT_URI=

# brrr notification icon (iPhone/iPad). Must be publicly reachable — not a tailnet URL.
# Leave blank to use the default brrr icon.
BRRR_ICON_URL=

# App URL (used for Plaid OAuth redirect construction)
APP_URL=

# MCP Server
MCP_PORT=3004
MCP_HOST=0.0.0.0
MCP_AUTH_TOKEN=

# Logging
LOG_LEVEL=info

# Sovereign shared fonts
SOVEREIGN_FONT_SOURCE=google
SOVEREIGN_FONT_SANS_CSS_URL=https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;500;600;700&display=swap
SOVEREIGN_FONT_MONO_CSS_URL=https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&display=swap
SOVEREIGN_FONT_SANS_CSS_URL_LOCAL=https://homebase.tailnet/_sovereign/fonts/source-sans-3.css
SOVEREIGN_FONT_MONO_CSS_URL_LOCAL=https://homebase.tailnet/_sovereign/fonts/jetbrains-mono.css

# ── Authentication ───────────────────────────────────────────
# One-time secret required for initial passphrase setup (bootstrap).
# Set this before first run, use it to set the first parent passphrase,
# then remove it. Prevents unauthorized first-writer takeover.
BOOTSTRAP_SECRET=
