{
  "name": "family-pulse",
  "version": "1.0.0",
  "description": "Family financial pulse — household money visibility with Plaid sync",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "npm run test:prepare && node --test-concurrency=1 --require ./test/bootstrap.js --test 'test/*.test.js'",
    "test:fast": "node --test-concurrency=1 --require ./test/bootstrap.js --test 'test/*.test.js'",
    "test:prepare": "npm run test:db:reset && npm run test:db:migrate && npm run test:db:seed",
    "test:db:reset": "node db/reset-test-db.js",
    "test:db:migrate": "node -e \"process.env.NODE_ENV='test'; require('./db/migrate.js')\"",
    "test:db:seed": "node db/seed.js",
    "test:ci": "npm run test",
    "db:clear-linked-data": "node db/clear-linked-data.js --yes",
    "sync": "node lib/cli.js sync",
    "notifications:run": "node scripts/send-notifications.js",
    "notifications:dry-run": "node scripts/send-notifications.js --dry-run",
    "accounts": "node lib/cli.js accounts",
    "status": "node lib/cli.js status",
    "test:e2e": "npx playwright test",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:debug": "npx playwright test --debug",
    "mcp": "node mcp/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^2.1.1",
    "node-cron": "^3.0.3",
    "openai": "^6.27.0",
    "pg": "^8.11.5",
    "plaid": "^28.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2"
  }
}
