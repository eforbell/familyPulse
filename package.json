{
  "name": "family-pulse",
  "version": "1.0.0",
  "description": "Forbell family financial pulse — household money visibility with Plaid sync",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "npm run test:prepare && node --require ./test/bootstrap.js --test",
    "test:fast": "node --require ./test/bootstrap.js --test",
    "test:prepare": "npm run test:db:reset && npm run test:db:migrate && npm run test:db:seed",
    "test:db:reset": "node db/reset-test-db.js",
    "test:db:migrate": "node -e \"process.env.NODE_ENV='test'; require('./db/migrate.js')\"",
    "test:db:seed": "node db/seed.js",
    "test:ci": "npm run test",
    "db:clear-linked-data": "node db/clear-linked-data.js --yes",
    "sync": "node lib/cli.js sync",
    "accounts": "node lib/cli.js accounts",
    "status": "node lib/cli.js status"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^2.1.1",
    "node-cron": "^3.0.3",
    "openai": "^6.27.0",
    "pg": "^8.11.5",
    "plaid": "^28.0.0"
  }
}
